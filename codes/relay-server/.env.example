# Copy to .env and adjust. Read by compose.yaml.

# Broker reached from inside the container. The Wokwi simulation uses the
# public broker below; for a Mosquitto on the host, use the address of the
# host on a Docker network (for example tcp://172.20.0.1:1883) and make
# Mosquitto listen on it.
MQTT_BROKER=wss://broker.emqx.io:8084/mqtt
MQTT_TOPIC_PREFIX=dt-sim-7f3a9c
MQTT_CLIENT_ID=robotarm-relay
MQTT_USERNAME=
MQTT_PASSWORD=

# Token required by /ws/scene and /api/command; empty disables authentication.
SCENE_TOKEN=

# Where the port is published on the host (gateway of catalyst-owner_default).
HOST_BIND=172.20.0.1
HOST_PORT=8080
