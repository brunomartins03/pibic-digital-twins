# Copy to .env and adjust. Read by compose.yaml.

# Broker reached from inside the container: the project's EMQX Serverless
# deployment, over WebSocket with TLS (the only outbound MQTT port the
# server's network allows). Its certificate chains to DigiCert Global Root G2,
# already trusted by the image. Users are managed in the EMQX console or its
# REST API; ask the project team for the relay's password.
MQTT_BROKER=wss://e2e69163.ala.eu-central-1.emqxsl.com:8084/mqtt
MQTT_TOPIC_PREFIX=robotarm
MQTT_CLIENT_ID=robotarm-relay
MQTT_USERNAME=robotarm-relay
MQTT_PASSWORD=

# Token required by /ws/scene and /api/command; empty disables authentication.
SCENE_TOKEN=

# Where the port is published on the host (gateway of catalyst-owner_default).
HOST_BIND=172.20.0.1
HOST_PORT=8080
