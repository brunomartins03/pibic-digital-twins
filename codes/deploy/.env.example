# Copy to .env and fill in. Read by compose.yaml; see README.md.

# ---------------------------------------------------------------- Realm
# URL the browser uses to reach this server, without a trailing slash. It is
# also the realm passed to the client (...&realm=<PUBLIC_URL>). On a remote
# server it must be https:// (TLS terminated by a proxy in front of nginx).
PUBLIC_URL=http://localhost
# Where nginx is published. If HTTP_PORT is not 80, include it in PUBLIC_URL.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
REALM_NAME=test

# Catalyst database passwords (generate with: openssl rand -hex 24).
POSTGRES_PASSWORD=
POSTGRES_CONTENT_PASSWORD=

# ------------------------------------------------------- Robotic arm relay
# Broker reached from inside the container. The project uses an EMQX
# Serverless deployment over WebSocket with TLS (see
# ../relay-server/docs/implantacao.md); ask the team for the password.
MQTT_BROKER=wss://e2e69163.ala.eu-central-1.emqxsl.com:8084/mqtt
MQTT_TOPIC_PREFIX=robotarm
# Must be unique per broker: a second relay with the same id disconnects the
# first one (e.g. the lab server's relay, which uses robotarm-relay).
MQTT_CLIENT_ID=robotarm-relay
MQTT_USERNAME=robotarm-relay
MQTT_PASSWORD=
# Token required by the relay's command endpoints; compiled into the scene.
# Empty disables authentication.
SCENE_TOKEN=
# Relay URL compiled into the robot scene. Defaults to ${PUBLIC_URL}/robotarm.
#RELAY_URL=

# ------------------------------------------------------------------ Comms
# Uncomment both lines to start archipelago, Pulse, comms-gatekeeper and
# LiveKit. ARCHIPELAGO_URL makes the realm advertise the comms adapter; leave
# it empty without the profile, or /about reports the realm unhealthy.
#COMPOSE_PROFILES=comms
#ARCHIPELAGO_URL=${PUBLIC_URL}

# PUBLIC_URL with ws:// or wss:// instead of http:// or https://.
LIVEKIT_PUBLIC_URL=ws://localhost
# IP that browsers use to reach the LiveKit RTC ports (3050/udp, 3060/tcp):
# the machine's public IP on a server, 127.0.0.1 on a local machine.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_RTC_BIND=0.0.0.0
# Any key name; the secret must be at least 32 characters
# (openssl rand -hex 32).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GATEKEEPER_DB_PASSWORD=
COMMS_GATEKEEPER_AUTH_TOKEN=
